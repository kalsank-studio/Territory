{
  // Territory on Cloudflare Workers: the game page (static files in dist/)
  // and the room relay (server/worker.js) on one free Worker.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "territory",
  "main": "server/worker.js",
  "compatibility_date": "2026-09-01",

  // Files in dist/ are served directly; only paths with no file (the /api/ ones) run the Worker.
  "assets": { "directory": "./dist" },

  // One Durable Object per room. The free plan needs the SQLite-backed kind.
  "durable_objects": {
    "bindings": [ { "name": "ROOMS", "class_name": "Room" } ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] }
  ],

  "observability": { "enabled": true }
}

{
  // ...
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
  // ...
}
